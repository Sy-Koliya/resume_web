[Unit]
Description=Bite Hunt Careers web application
After=network.target

[Service]
Type=simple
User=bitehunt
Group=bitehunt
WorkingDirectory=@@INSTALL_ROOT@@/current
Environment=BITE_HUNT_CONFIG=@@CONFIG_FILE@@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@@ENV_FILE@@
ExecStart=@@INSTALL_ROOT@@/venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0027
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=@@DATA_ROOT@@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
